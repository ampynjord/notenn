# Copy to .env (never committed), then fill in.
DOMAIN=notenn.ampynjord.bzh

# Passwords: generate with  openssl rand -hex 32
POSTGRES_PASSWORD=
PAYLOAD_SECRET=

# Traefik already running on the VPS: Docker network name, HTTPS entry point and certificate resolver.
TRAEFIK_NETWORK=traefik-network
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

BACKUP_KEEP_DAYS=14

# Account e-mails through Resend (see README): API key and sender on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=notenn@ampynjord.bzh
