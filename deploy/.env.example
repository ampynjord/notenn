# Copier en .env (jamais commité) puis remplir.
DOMAIN=notenn.ampynjord.bzh

# Mots de passe : générer avec  openssl rand -hex 32
POSTGRES_PASSWORD=
PAYLOAD_SECRET=

# Traefik déjà en place sur le VPS : nom du réseau Docker, point d'entrée HTTPS et résolveur de certificats.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

BACKUP_KEEP_DAYS=14
