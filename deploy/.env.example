# Copy to .env (never committed), then fill in.
DOMAIN=notenn.ampynjord.bzh

# Passwords: generate with  openssl rand -hex 32
POSTGRES_PASSWORD=
PAYLOAD_SECRET=

# Traefik already running on the VPS: Docker network name, HTTPS entry point and certificate resolver.
TRAEFIK_NETWORK=traefik-network
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

BACKUP_KEEP_DAYS=14

# Visit statistics with Umami (optional, see README): generate both with  openssl rand -hex 32
STATS_DOMAIN=stats.ampynjord.bzh
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=
# Filled in after creating the site in Umami:
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=
